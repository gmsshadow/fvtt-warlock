{"_id":"0csFyQTCTSis6HAh","name":"Obfuscate Program","type":"Program","img":"icons/svg/book.svg","system":{"description":"<p>Hide the theft of data or place data in a file or node without being noticed.</p><p>Resource cost by rating: 1: 10, 2: 19, 3: 22, 4: 25, 5: 30, 6: 40. Compromise programs cost 1.25x and Attack programs 1.5x (p169). A program's rating cannot exceed its deck's quality.</p>","programType":{"value":"Obfuscate"},"rating":1,"resourceCost":10},"effects":[],"folder":null,"sort":1400,"flags":{},"ownership":{"default":0},"_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.12","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}
