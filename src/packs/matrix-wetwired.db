{"_id":"MBDGK6W1val8UdsL","name":"Radio Shack POS-5","type":"Cyberdeck","img":"icons/svg/terminal.svg","system":{"description":"<p>A cyberdeck's quality is added to matrix skill tests, together with the rating of the program suited to the action. It can hold programs up to its quality in number, and each program's rating cannot exceed the deck's quality. A datajack is required to use a deck (p143).</p>","quality":1,"resourceCost":20},"effects":[],"folder":null,"sort":0,"flags":{},"ownership":{"default":0},"_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.12","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}
