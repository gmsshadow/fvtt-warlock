Time":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"Crew hit by falling ship components! A random member of the crew loses [[/roll 3d6]] stamina.","name":""},{"_id":"J0uzoQDQQPokRdPC","type":"text","weight":1,"range":[7,7],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"Everyone knocked off their feet and flung against the wall. Stunned and prone for [[/roll 1d6]] rounds, all tests at a penalty of -3.","name":""},{"_id":"w6E22BU5bMV7jyDN","type":"text","weight":1,"range":[8,8],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"Engines die! No change of course or speed until repaired.","name":""},{"_id":"ZBqYzhzUkQKJ93Nb","type":"text","weight":1,"range":[9,9],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"Integrity loss! All air evacuated in 4 rounds. Get to the suits!","name":""},{"_id":"oZv4Lwflkn7s31S3","type":"text","weight":1,"range":[10,999],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"Blasted and destroyed!","name":""}],"formula":"2d6+1","replacement":true,"displayRoll":true,"folder":null,"sort":0,"flags":{},"_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"ownership":{"default":0,"ZtfDqSvKTGtngaYG":3},"description":""}
{"_id":"z1hXYx7O38iO41kz","name":"Warp Bleed","img":"systems/warlock/assets/icons/items/spells/wind-hole.svg","results":[{"_id":"pBt1Dry6YAe5URSJ","type":"text","weight":1,"range":[1,1],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"The caster's hands catch fire causing them [[/roll 1d6]] stamina damage.","name":""},{"_id":"DZ0jZ06tJqz4oezb","type":"text","weight":1,"range":[2,2],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"Two mindless tentacles grow from the user's body for [[/roll 1d6]] days.","name":""},{"_id":"ykf9gq3KnkoV9Jmf","type":"text","weight":1,"range":[3,3],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"One of the caster's eyes turns milky white.","name":""},{"_id":"81BekGTo992y5JKr","type":"text","weight":1,"range":[4,4],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"The glyph discharges incorrectly, hitting the nearest creature for [[/roll 2d6]] stamina damage.","name":""},{"_id":"RABPgDuVmldt0XKv","type":"text","weight":1,"range":[5,5],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"The caster vomits acidic ectoplasm on all nearby causing [[/roll 1d6]] stamina damage.","name":""},{"_id":"qG0KtpxK36Fw7fSS","type":"text","weight":1,"range":[6,6],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"Blood runs from the eyes for [[/roll 1d6]] days.","name":""},{"_id":"2Cs64Pz4evCOzuA8","type":"text","weight":1,"range":[7,7],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"The glyph backfires, blasting the caster across the room for [[/roll 2d6]] stamina damage.","name":""},{"_id":"7lIFfgzOfTWqDHMy","type":"text","weight":1,"range":[8,8],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"The caster loses the sense of taste, all food is like ash.","name":""},{"_id":"woU3zsT1lNBuDQe7","type":"text","weight":1,"range":[9,9],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"The caster's skin is bleached white.","name":""},{"_id":"SRaGA61YhH1nOxMg","type":"text","weight":1,"range":[10,10],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"All of the caster's hair falls out.","name":""},{"_id":"3ekA27uszXiuyibq","type":"text","weight":1,"range":[11,11],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"The caster's skin becomes translucent for [[/roll 2d6]] days.","name":""},{"_id":"NcUnYuf2B3erComo","type":"text","weight":1,"range":[12,12],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"The caster's arms are altered, growing small bone spurs.","name":""},{"_id":"upKNdP0KUim3YOHr","type":"text","weight":1,"range":[13,13],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"The caster freezes like a statue for the next [[/roll 1d3]] days.","name":""},{"_id":"YYunmiUjkiH1Ukax","type":"text","weight":1,"range":[14,14],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"A miasma of warp energies fill a nearby space, causing [[/roll 1d6+2]] stamina damage to all.","name":""},{"_id":"x7liRdZmTQOQRdsn","type":"text","weight":1,"range":[15,15],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"The caster's eyes turn jet black for [[/roll 1d6]] weeks.","name":""},{"_id":"Zel5SFBMiPJlz8TP","type":"text","weight":1,"range":[16,16],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"The caster is possessed by a malevolent warp being for [[/roll 1d6]] turns.","name":""},{"_id":"GuSDv2PShV3UlK3p","type":"text","weight":1,"range":[17,17],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"The caster loses the ability to manifest glyphs for [[/roll 1d6]] days, every attempt causes warp bleed.","name":""},{"_id":"wXKOhnRV4YhVBUSi","type":"text","weight":1,"range":[18,18],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"The user gains a minor warp mutation.","name":""},{"_id":"m0oGZh6pBAIgCtzL","type":"text","weight":1,"range":[19,19],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"The user gains a major warp mutation.","name":""},{"_id":"2xd65snpcvYTlZVj","type":"text","weight":1,"range":[20,20],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"The user is swallowed by the warp!","name":""}],"formula":"1d20","replacement":true,"displayRoll":true,"folder":null,"sort":0,"flags":{},"_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"ownership":{"default":0,"ZtfDqSvKTGtngaYG":3},"description":""}
{"_id":"foCPlzGUiRRyncEA","name":"Talent Table 1","img":"icons/svg/aura.svg","results":[{"_id":"uGeBZ2SgRHXHQH0k","type":"text","weight":1,"range":[1,1],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Ambidextrous","description":"<p><strong>Ambidextrous:</strong> You have more than one dominant limb, and as such can wield multiple melee weapons. When armed with more than one melee weapon, you may roll to hit once without the +5 bonus. If you successfully hit, you roll both damage dice and add them together.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"pm7SLfm9X4L4K0LE","type":"text","weight":1,"range":[2,2],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Armour","description":"<p><strong>Armour:</strong> You know your shield generator from your power armour, or have innate armour under your skin. You may add 1 to the protective quality of any armour you wear.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"QXNjwaexVBGpAGLE","type":"text","weight":1,"range":[3,3],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Beast Friend","description":"<p><strong>Beast Friend:</strong> You have a rapport with normal animals, or come from a species which can telepathically communicate with beasts. Unless you or an ally attacks or provokes an animal, it will regard you as a friend and not attempt to hurt you, even if hungry or aggressive.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"KHfGOeL4RBHpqWK4","type":"text","weight":1,"range":[4,4],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Consummate Professional","description":"<p><strong>Consummate Professional:</strong> You strive to be the best at what you do, whether that is exterminating void ticks or peddling wares. You add 2 to all of your Career Skill ratings.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"7kEMQUF0UBTpPDuH","type":"text","weight":1,"range":[5,5],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Dark Sight","description":"<p><strong>Dark Sight:</strong> Either due to implants or innate ability, you see as well by moonlight as in day, like a sker-raptor.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"gwjtD9zGzFv14LHh","type":"text","weight":1,"range":[6,6],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Deadly Aim","description":"<p><strong>Deadly Aim:</strong> Your aim is true and you strike with pin-point accuracy. Add 1 to all damage inflicted with ranged weapons.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"JVHQNRmQ5uiQ0IcF","type":"text","weight":1,"range":[7,7],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Born Haggler","description":"<p><strong>Born Haggler:</strong> You are always looking for the best deal possible and are loathe to give up those shiny coins. You may subtract 1 from each d6 rolled to determine the price of anything you purchase. If this generates a result of zero, the Game Master must roll again on the next lowest coin (jades to shards, shards to frags) down to a minimum of 1 frag.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"Y1t5WmI6Fpq6z8qP","type":"text","weight":1,"range":[8,8],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Eyes of a Hawk","description":"<p><strong>Eyes of a Hawk:</strong> Your keen visual senses are able to spot detail from great distances. As such, you may ignore the penalty for shooting at a target far away from you.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"Jsj9GLQGgnwmXCxW","type":"text","weight":1,"range":[9,9],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Fists of Stone","description":"<p><strong>Fists of Stone:</strong> Perhaps you have proto-gorgon blood coursing through your veins, or have bony protrusions on the backs of your hands. Either way, you inflict [[/roll 1d6]] damage with your bare hands.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"GxobxAHaCHnlxhKz","type":"text","weight":1,"range":[10,10],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Hard to Kill","description":"<p><strong>Hard to Kill:</strong> 'Tis but a scratch!'. Owing to your hardened physique, regenerative powers or sheer force of will, you may subtract 2 from all Critical hit rolls you take. Any result of 1 or less is ignored.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"Lxp0iQAid1DYfbea","type":"text","weight":1,"range":[11,11],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Ill-gotten Gains","description":"<p><strong>Ill-gotten Gains:</strong> You have acquired some stolen loot. Perhaps you found it buried on a moon, won it at cards, purloined it from a Noble's spacecraft or prised it from the hands of your last victim. Either way, you start the game with a notable rare item, which you can define during play just when you need it...</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"1GGfkN2k3UnYk7dx","type":"text","weight":1,"range":[12,12],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Innate Warp Glyph","description":"<p><strong>Innate Warp Glyph:</strong> You have the ability to channel one random warp glyph. This still requires a Warp focus test and the expenditure of Stamina, like a normal warp glyph.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"dksJhrqj9y8LTjyC","type":"text","weight":1,"range":[13,13],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Lightning Reflexes","description":"<p><strong>Lightning Reflexes:</strong> Either naturally or as the result of cybernetics, you possess the reflexes of a glower cat. Unless surprised, you may always act first in a round.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"Rq7fGQMtAj3mw37J","type":"text","weight":1,"range":[14,14],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Luck of the universe","description":"<p><strong>Luck of the universe:</strong> You are blessed with good fortune, or perhaps are destined for greater things. Increase your Luck by 2.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"3CnteNiZPSws98c0","type":"text","weight":1,"range":[15,15],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Natural Talent","description":"<p><strong>Natural Talent:</strong> Choose one adventuring skill. That skill may always be improved, no matter what career you are in, but only up to 10, if you are in a Basic Career, or 14 you are in an Advanced Career.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"iHxJlURMAZlEZuja","type":"text","weight":1,"range":[16,16],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Strong Arm","description":"<p><strong>Strong Arm:</strong> You strike with powerful, savage blows. Add 1 to all damage inflicted with melee weapons.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"h7obUoO2uhyczWLN","type":"text","weight":1,"range":[17,17],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Thick-skinned","description":"<p><strong>Thick-skinned:</strong> You certainly know how to take a beating. Reduce the damage inflicted upon you from crushing weapons by 1.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"YmE4o1PKecF8c3cQ","type":"text","weight":1,"range":[18,18],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Tough as Nails","description":"<p><strong>Tough as Nails:</strong> You possess incredible reserves of endurance and hardiness. Increase your Stamina by 4.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"r6gyPHuvoXhhVA48","type":"text","weight":1,"range":[19,19],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Uncanny Sense","description":"<p><strong>Uncanny Sense:</strong> You have a natural ability to avoid danger, be it a latent psychic ability, exceptional paranoia or perhaps dark whispers from beyond the material universe. Regardless of its source, you cannot be surprised.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"MxzhRO6MX1UFDRff","type":"text","weight":1,"range":[20,20],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Warp Sight","description":"<p><strong>Warp Sight:</strong> You have the innate ability to detect warp forces and phenomena. You may make a Spot roll to detect the presence of glyph effects and warp entities.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"formula":"1d20","replacement":true,"displayRoll":true,"folder":null,"sort":0,"flags":{},"ownership":{"default":0},"description":"Roll 1d20, or roll on both tables and choose one (Warpstar! p16-24).","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"_id":"3Dh5gjlrq6grjn3h","name":"Talent Table 2","img":"icons/svg/aura.svg","results":[{"_id":"MiAylcqyJrLcgMCS","type":"text","weight":1,"range":[1,1],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Highly Attractive","description":"<p><strong>Highly Attractive:</strong> You dazzle others with your chiselled features or luscious locks. You may automatically succeed at the first Bargain or Persuasion test each session if a target would find you attractive, as adjudicated by the games master (or test your luck).</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"DllDDonjtKBBCsN9","type":"text","weight":1,"range":[2,2],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Cast Iron Stomach","description":"<p><strong>Cast Iron Stomach:</strong> You are immune to all ingested poisons including alcohol. You may even derive nutrition from spoiled or rotting food, much to the repulsion of your fellow adventurers.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"F0Jo8oeebyHlZzNM","type":"text","weight":1,"range":[3,3],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Jack-of-all-Trades","description":"<p><strong>Jack-of-all-Trades:</strong> You can pick up skills quickly or perhaps have had experience in a few trades before settling on your current career. You are treated as having a career skill rating of at least 4 in three Basic careers you choose.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"Ew2oQD7GsRiKHGtu","type":"text","weight":1,"range":[4,4],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Light Sleeper","description":"<p><strong>Light Sleeper:</strong> You sleep with one eye open. Or as a result of your non-human nature barely need to sleep at all. You may make a Spot test to detect an ambush, even when sleeping. You may also instantly awake in such circumstances and be ready to take an action.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"PUBb3YgsD054bXPW","type":"text","weight":1,"range":[5,5],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Psychic Resistance","description":"<p><strong>Psychic Resistance:</strong> You have an innate ability to resist warp glyphs. You may make a Warp focus test to negate any glyph directed directly at you. However, when making a Warp focus test to manifest warp glyphs, any failed test results in bleed.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"5HGUh9V8NJSc6prh","type":"text","weight":1,"range":[6,6],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Acute Hearing","description":"<p><strong>Acute Hearing:</strong> As a result of non-human physique or just a natural gift, you may make a Spot test to hear whispers and quiet conversations, even when several yards from you. You can also make such tests to hear normal conversations on the other side of doors.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"K8VSnnPFsMIr2rxw","type":"text","weight":1,"range":[7,7],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Prophetic Dreams","description":"<p><strong>Prophetic Dreams:</strong> You are plagued by strange dreams, which can warn you of things to come. Once per session, if you fail a test, you may test your luck. If successful, you succeed at the test instead. You were clearly just remembering when you failed the attempt in your dream...</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"bYQCWL1iqANYiYkf","type":"text","weight":1,"range":[8,8],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Killer Instinct","description":"<p><strong>Killer Instinct:</strong> You want to see your foes die, often in the most grisly way possible. You may add 2 to the value of any critical hit you inflict.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"ajnaJOooCmYPyi6U","type":"text","weight":1,"range":[9,9],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Sense of Direction","description":"<p><strong>Sense of Direction:</strong> You have an instinctive ability to detect 'north' on a planetary surface and so never get lost.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"wLIuWtT3qKzlD0At","type":"text","weight":1,"range":[10,10],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Double-Jointed","description":"<p><strong>Double-Jointed:</strong> Your body is extremely flexible, or you have tentacles instead of limbs. You may squeeze into the smallest spaces, easily escape from manacles or restraints and even fit through small gaps such as iron bars.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"gpzCdPLuf5D0EOFT","type":"text","weight":1,"range":[11,11],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Dark Destiny","description":"<p><strong>Dark Destiny:</strong> Some strange warp entity is looking out for you. If you should die, for whatever reason, you miraculously survive. However, the entity will reveal its plans to you with whispers of dark desires. Should you decide to act against its wishes, you must lose [[/roll 1d3]] stamina permanently, unless you successfully test your luck.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"7Oxmsn8bQokvXmqK","type":"text","weight":1,"range":[12,12],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Fleet Footed","description":"<p><strong>Fleet Footed:</strong> You are exceptionally fast on your feet, or perhaps are a quadruped. In combat you may move one range category and still perform an action, although you suffer -2 penalty to tests when doing so. You may also take a move action to move two range categories, instead of one. Outside of combat, you may add 4 to your Athletics to all tests involving sprinting.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"i4vr378xee97ISlr","type":"text","weight":1,"range":[13,13],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Natural Charm","description":"<p><strong>Natural Charm:</strong> Unless they have reasons to act differently, most people take a shine to you; people find it easy to get along with you. Whenever you meet someone, if they would normally be ambivalent toward you, now they like you, and those that would normally dislike you instead are ambivalent.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"CKbxYEp2pW0k46Cn","type":"text","weight":1,"range":[14,14],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Sleep Anywhere","description":"<p><strong>Sleep Anywhere:</strong> You have a talent for sleeping anywhere - you always get a good rest no matter where you are, and always wake up happy and refreshed, even if sleeping outside in the acid rain.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"AqZZIkmouOY15mVm","type":"text","weight":1,"range":[15,15],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Well-Connected","description":"<p><strong>Well-Connected:</strong> You have a wide circle of acquaintances who you may draw upon for aid. Once per session you may make a luck test. If successful, you have bumped into an old friend who owes you a favour.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"3t4kdxwoSnpj1E84","type":"text","weight":1,"range":[16,16],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Perfect Recall","description":"<p><strong>Perfect Recall:</strong> Due to cybernetics or bizarre brain chemistry, you have an amazing memory and never forget anything you have seen or read. You never forget the contents of a datapad you quickly skimmed through, even if you saw it only for a moment.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"K2euESoWvo2OxJWW","type":"text","weight":1,"range":[17,17],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Slink Away","description":"<p><strong>Slink Away:</strong> Somehow, you always manage to slink away from danger, either because you are very small or because you are a slippery customer. Whenever you are caught in a large combat with multiple combatants and have some warning (i.e. are not surprised), test your Luck. If you succeed, you somehow escape notice...</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"o67DFBmrPDVzofyG","type":"text","weight":1,"range":[18,18],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Non-descript","description":"<p><strong>Non-descript:</strong> For some reason, you just do not stick in the mind. People tend to forget what you look like, and are often quite hard-pressed to recall anything remarkable about you at all.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"qaDFZpkwD7AehUoP","type":"text","weight":1,"range":[19,19],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Scarred","description":"<p><strong>Scarred:</strong> You obtained a scar on your face in your childhood. It makes it easier to intimidate people (+2 bonus) and generally to look mean and impressive, but makes it harder to charm people (-2 penalty to charm and persuasion tests).</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"WaGbCigclSetzqR2","type":"text","weight":1,"range":[20,20],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","name":"Evil Eye","description":"<p><strong>Evil Eye:</strong> You have the uncanny ability to hex opponents with your gaze. Once per game session, when an opponent succeeds at a simple or opposed test, you can test your luck. If you are lucky, they failed the test or if it was opposed, you won.</p>","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"formula":"1d20","replacement":true,"displayRoll":true,"folder":null,"sort":0,"flags":{},"ownership":{"default":0},"description":"Roll 1d20, or roll on both tables and choose one (Warpstar! p16-24).","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}
