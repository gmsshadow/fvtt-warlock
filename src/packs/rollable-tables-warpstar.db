ID[Compendium.warlock.careers-basic-warpstar.Item.ecD8LWIvs1wzp6Oq]{Entertainer}","name":"","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}},{"_id":"ajEQbeZRz4IL5laX","type":"text","weight":1,"range":[6,6],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","description":"@UUID[Compendium.warlock.careers-basic-warpstar.Item.VGnYvS9CzxOy5i2H]{Exterminator}","name":"","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}],"formula":"1d6","replacement":true,"displayRoll":true,"folder":null,"sort":0,"flags":{},"ownership":{"default":0},"description":"Roll a d6 on each of the four columns and choose one of the four careers (Warpstar! p33).","_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.13","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}
