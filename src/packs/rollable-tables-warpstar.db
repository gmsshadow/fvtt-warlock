,"description":"Smashed on the skull and brained, dead.","name":""}],"formula":"2d6+1","replacement":true,"displayRoll":true,"folder":null,"sort":0,"flags":{},"_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"ownership":{"default":0,"ZtfDqSvKTGtngaYG":3},"description":""}
{"_id":"iDtVH3INUBhf3YJX","name":"Critical - Piercing","img":"icons/svg/skull.svg","results":[{"_id":"xBE4jAtytWJw2sKl","type":"text","weight":1,"range":[2,2],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"Right through the forearm, pass a sleight-of-hand test to keep hold of your weapon.","name":""},{"_id":"icF77rnX0w3r25qp","type":"text","weight":1,"range":[3,3],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"A punctured rump! Very painful, all tests at a penalty of -3 for the next [[/roll 1d6]] rounds","name":""},{"_id":"0Y00s626yvvZXFGG","type":"text","weight":1,"range":[4,4],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"A hole in the guts, forces dinner up and over everyone. Spend [[/roll 1d6]] rounds retching, all actions are at a penalty of -3.","name":""},{"_id":"58wdx01aX6uuHuWx","type":"text","weight":1,"range":[5,5],"drawn":false,"flags":{},"img":"icons/svg/d20-black.svg","_stats":{"coreVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null},"description":"Right in the neck, can do nothing but gasp for breath and defend at a penalty of -2 for [[/roll 1d6]] rounds.","name":""},{"_id":"dBKMoXL8nvUWwfjV","type":"text","weight":1,"range":[6,6],"drawn":false,"flags":{},"img":