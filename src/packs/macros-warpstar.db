eVersion":"13.351","systemId":null,"systemVersion":null,"createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":"Macro.kPEsS7QLBYxVGzU7","duplicateSource":null,"exportSource":null},"ownership":{"default":0,"ZtfDqSvKTGtngaYG":3}}
