{"_id":"2UiONsUFj42ueYeJ","name":"Critical - Crushing","type":"script","author":"lKXh2ZRkB8Ue5orB","img":"icons/svg/skull.svg","scope":"global","command":"// Roll on the Critical - Crushing table.\n// Warlock! p83: a hit that takes a character below 0 stamina is a critical.\n// Roll 1d6 and add the stamina below 0 (always at least 1); 10 or more is death.\nconst TABLE_NAME = \"Critical - Crushing\";\n\nconst content = `\n    <div class=\"form-group\">\n        <label>Stamina below 0</label>\n        <input type=\"number\" name=\"negative\" value=\"1\" min=\"1\" step=\"1\" autofocus>\n        <p class=\"hint\">How far below 0 the hit took the target's stamina, as a positive number (at least 1). Include any earlier negative stamina, as the total is cumulative.</p>\n    </div>`;\n\nconst negative = await foundry.applications.api.DialogV2.prompt({\n    window: { title: TABLE_NAME },\n    content,\n    ok: {\n        label: \"Roll\",\n        icon: \"fas fa-dice\",\n        callback: (event, button) => button.form.elements.negative.valueAsNumber,\n    },\n    rejectClose: false,\n});\nif (negative === null || negative === undefined) return;\n\n// A critical always adds at least 1, so the roll is never a plain 1d6.\nconst modifier = Math.max(1, Math.floor(Number(negative) || 1));\n\n// Prefer a table imported into the world; otherwise use the system compendium.\nlet table = game.tables.getName(TABLE_NAME);\nif (!table) {\n    const pack = game.packs.get(\"warlock.rollable-tables-warlock\");\n    const index = pack ? await pack.getIndex() : null;\n    const entry = index?.find((e) => e.name === TABLE_NAME);\n    if (entry) table = await pack.getDocument(entry._id);\n}\nif (!table) {\n    ui.notifications.error(`Could not find the \"${TABLE_NAME}\" table.`);\n    return;\n}\n\n// Totals of 10 or more land on the 10+ result (\"dead\").\nawait table.draw({ roll: new Roll(`1d6 + ${modifier}`) });\n","folder":null,"sort":0,"permission":{"default":0,"HcHB4gb18gtp2Q2n":3},"flags":{"core":{"sourceId":"Macro.2UiONsUFj42ueYeJ"}}}
{"_id":"70P084CQ4Y68YhqP","name":"Critical - Piercing","type":"script","author":"lKXh2ZRkB8Ue5orB","img":"icons/svg/skull.svg","scope":"global","command":"// Roll on the Critical - Piercing table.\n// Warlock! p83: a hit that takes a character below 0 stamina is a critical.\n// Roll 1d6 and add the stamina below 0 (always at least 1); 10 or more is death.\nconst TABLE_NAME = \"Critical - Piercing\";\n\nconst content = `\n    <div class=\"form-group\">\n        <label>Stamina below 0</label>\n        <input type=\"number\" name=\"negative\" value=\"1\" min=\"1\" step=\"1\" autofocus>\n        <p class=\"hint\">How far below 0 the hit took the target's stamina, as a positive number (at least 1). Include any earlier negative stamina, as the total is cumulative.</p>\n    </div>`;\n\nconst negative = await foundry.applications.api.DialogV2.prompt({\n    window: { title: TABLE_NAME },\n    content,\n    ok: {\n        label: \"Roll\",\n        icon: \"fas fa-dice\",\n        callback: (event, button) => button.form.elements.negative.valueAsNumber,\n    },\n    rejectClose: false,\n});\nif (negative === null || negative === undefined) return;\n\n// A critical always adds at least 1, so the roll is never a plain 1d6.\nconst modifier = Math.max(1, Math.floor(Number(negative) || 1));\n\n// Prefer a table imported into the world; otherwise use the system compendium.\nlet table = game.tables.getName(TABLE_NAME);\nif (!table) {\n    const pack = game.packs.get(\"warlock.rollable-tables-warlock\");\n    const index = pack ? await pack.getIndex() : null;\n    const entry = index?.find((e) => e.name === TABLE_NAME);\n    if (entry) table = await pack.getDocument(entry._id);\n}\nif (!table) {\n    ui.notifications.error(`Could not find the \"${TABLE_NAME}\" table.`);\n    return;\n}\n\n// Totals of 10 or more land on the 10+ result (\"dead\").\nawait table.draw({ roll: new Roll(`1d6 + ${modifier}`) });\n","folder":null,"sort":0,"permission":{"default":0,"HcHB4gb18gtp2Q2n":3},"flags":{"core":{"sourceId":"Macro.70P084CQ4Y68YhqP"}}}
