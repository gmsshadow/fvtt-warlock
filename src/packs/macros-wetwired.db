{"_id":"w7NZuTZ2TR418S4q","name":"Critical - Blunt","type":"script","author":null,"img":"icons/svg/skull.svg","scope":"global","command":"// Roll on the Critical - Blunt table.\n// Wetwired p113-122: a hit that takes a target below 0 stamina (or structure) is a critical.\n// Roll 2d6 and add the stamina below 0 (always at least 1); 10 or more is death.\nconst TABLE_NAME = \"Critical - Blunt\";\n\nconst content = `\n    <div class=\"form-group\">\n        <label>Stamina below 0</label>\n        <input type=\"number\" name=\"negative\" value=\"1\" min=\"1\" step=\"1\" autofocus>\n        <p class=\"hint\">How far below 0 the hit took the target's stamina, as a positive number (at least 1). Include any earlier negative stamina, as the total is cumulative.</p>\n    </div>`;\n\nconst negative = await foundry.applications.api.DialogV2.prompt({\n    window: { title: TABLE_NAME },\n    content,\n    ok: {\n        label: \"Roll\",\n        icon: \"fas fa-dice\",\n        callback: (event, button) => button.form.elements.negative.valueAsNumber,\n    },\n    rejectClose: false,\n});\nif (negative === null || negative === undefined) return;\n\n// A critical always adds at least 1, so the roll is never a plain 2d6.\nconst modifier = Math.max(1, Math.floor(Number(negative) || 1));\n\n// Prefer a table imported into the world; otherwise use the system compendium.\nlet table = game.tables.getName(TABLE_NAME);\nif (!table) {\n    const pack = game.packs.get(\"warlock.rollable-tables-wetwired\");\n    const index = pack ? await pack.getIndex() : null;\n    const entry = index?.find((e) => e.name === TABLE_NAME);\n    if (entry) table = await pack.getDocument(entry._id);\n}\nif (!table) {\n    ui.notifications.error(`Could not find the \"${TABLE_NAME}\" table.`);\n    return;\n}\n\n// Totals of 10 or more land on the 10+ result (\"dead\").\nawait table.draw({ roll: new Roll(`2d6 + ${modifier}`) });\n","folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.12","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}
{"_id":"AjPeJPtr0e6Wp5BY","name":"Critical - Concussive","type":"script","author":null,"img":"icons/svg/skull.svg","scope":"global","command":"// Roll on the Critical - Concussive table.\n// Wetwired p113-122: a hit that takes a target below 0 stamina (or structure) is a critical.\n// Roll 2d6 and add the stamina below 0 (always at least 1); 10 or more is death.\nconst TABLE_NAME = \"Critical - Concussive\";\n\nconst content = `\n    <div class=\"form-group\">\n        <label>Stamina below 0</label>\n        <input type=\"number\" name=\"negative\" value=\"1\" min=\"1\" step=\"1\" autofocus>\n        <p class=\"hint\">How far below 0 the hit took the target's stamina, as a positive number (at least 1). Include any earlier negative stamina, as the total is cumulative.</p>\n    </div>`;\n\nconst negative = await foundry.applications.api.DialogV2.prompt({\n    window: { title: TABLE_NAME },\n    content,\n    ok: {\n        label: \"Roll\",\n        icon: \"fas fa-dice\",\n        callback: (event, button) => button.form.elements.negative.valueAsNumber,\n    },\n    rejectClose: false,\n});\nif (negative === null || negative === undefined) return;\n\n// A critical always adds at least 1, so the roll is never a plain 2d6.\nconst modifier = Math.max(1, Math.floor(Number(negative) || 1));\n\n// Prefer a table imported into the world; otherwise use the system compendium.\nlet table = game.tables.getName(TABLE_NAME);\nif (!table) {\n    const pack = game.packs.get(\"warlock.rollable-tables-wetwired\");\n    const index = pack ? await pack.getIndex() : null;\n    const entry = index?.find((e) => e.name === TABLE_NAME);\n    if (entry) table = await pack.getDocument(entry._id);\n}\nif (!table) {\n    ui.notifications.error(`Could not find the \"${TABLE_NAME}\" table.`);\n    return;\n}\n\n// Totals of 10 or more land on the 10+ result (\"dead\").\nawait table.draw({ roll: new Roll(`2d6 + ${modifier}`) });\n","folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"coreVersion":"14.352","systemId":"warlock","systemVersion":"2.5.12","createdTime":null,"modifiedTime":null,"lastModifiedBy":null,"compendiumSource":null,"duplicateSource":null,"exportSource":null}}
