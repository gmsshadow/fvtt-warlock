{"_id":"VMTcduroMS1wQEDg","name":"Tribal Blockser","type":"Career","img":"icons/svg/item-bag.svg","system":{"description":"<p>You are part of the Blocks now, even though you affect Tribal traditions. Either a Tribesman who was forced to come to the city for some reason and decided to stay, or a chummer who found a latent connection to Tribal living and a mentor.</p><p>Etiquette: Street and Tribal</p><p>Requirement: Tribal career or a mentor or group who will take you in and teach you Tribal ways.</p>","isActive":false,"currentLevel":0,"activeSystem":"wetwired","etiquette":{"value":"Street"},"adventuringSkills":{"Appraise":{"isCareerSkill":false,"maximumLevel":0},"Athletics":{"isCareerSkill":false,"maximumLevel":0},"Bargain":{"isCareerSkill":false,"maximumLevel":0},"Computer Hardware":{"isCareerSkill":false,"maximumLevel":0},"Computer Software":{"isCareerSkill":false,"maximumLevel":0},"Conjuring":{"isCareerSkill":false,"maximumLevel":0},"Cybertech: Bodyware":{"isCareerSkill":false,"maximumLevel":0},"Cybertech: Headware":{"isCareerSkill":false,"maximumLevel":0},"Demolitions":{"isCareerSkill":false,"maximumLevel":0},"Disguise":{"isCareerSkill":false,"maximumLevel":0},"Dodge":{"isCareerSkill":false,"maximumLevel":0},"Drive":{"isCareerSkill":false,"maximumLevel":0},"Endurance":{"isCareerSkill":true,"maximumLevel":14},"Engineering":{"isCareerSkill":false,"maximumLevel":0},"Fly":{"isCareerSkill":false,"maximumLevel":0},"Gunnery":{"isCareerSkill":false,"maximumLevel":0},"Heavy Armour":{"isCareerSkill":false,"maximumLevel":0},"Leadership":{"isCareerSkill":false,"maximumLevel":0},"Medicine":{"isCareerSkill":false,"maximumLevel":0},"Melee":{"isCareerSkill":true,"maximumLevel":14},"Persuasion":{"isCareerSkill":false,"maximumLevel":0},"Primitive Ranged":{"isCareerSkill":true,"maximumLevel":16},"Small arms":{"isCareerSkill":true,"maximumLevel":14},"Sorcery":{"isCareerSkill":false,"maximumLevel":0},"Spot":{"isCareerSkill":false,"maximumLevel":0},"Stealth":{"isCareerSkill":true,"ma