<div
    class="{{cssClass}} document"
    autocomplete="off">
    <header class="header">
        <div class="header__body">
            <div class="header__row">
                <input
                    class="header__name field field--no-decoration field--center"
                    type="text"
                    name="name"
                    value="{{item.name}}"
                    data-dtype="String">
            </div>
        </div>
    </header>

    <section class="body">
        <div class="flex flex--column flex--no-gap">
            <h1>
                {{localize "WARLOCK.Items.Equipment.Description"}}
            </h1>

            <prose-mirror
                name="system.description"
                value="{{data.system.description}}"
                data-document-uuid="{{document.uuid}}"
                toggled
                {{#unless editable}}disabled{{/unless}}>
                {{{enriched.description}}}
            </prose-mirror>
        </div>
    </section>
</div>
