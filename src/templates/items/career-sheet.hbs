<div
    class="{{cssClass}} document"
    autocomplete="off">
    <header class="header">
        <div class="header__body">
            <div class="header__row">
                <input
                    class="header__name field field--no-decoration field--center"
                    type="text"
                    name="name"
                    value="{{item.name}}"
                    data-dtype="String">
            </div>
            {{#if gameConfig.features.contacts}}
            <div class="header__row">
                <div class="resource">
                    <label class="resource__name">
                        {{localize "WARLOCK.Items.Career.Etiquette"}}
                    </label>

                    <div class="resource__body">
                        <select
                            class="field field--no-decoration"
                            name="system.etiquette.value">
                            {{selectOptions
                                data.system.etiquette.choices
                                selected=data.system.etiquette.value}}
                        </select>
                    </div>
                </div>
            </div>
            {{/if}}
        </div>
    </header>

    <nav
        class="tabs"
        data-group="primary">
        <a
            class="tabs__item {{tabs.skills.cssClass}}"
            data-action="tab"
            data-group="primary"
            data-tab="skills">
            {{localize "WARLOCK.Tabs.Skills"}}
        </a>

        <a
            class="tabs__item {{tabs.description.cssClass}}"
            data-action="tab"
            data-group="primary"
            data-tab="description">
            {{localize "WARLOCK.Tabs.Description"}}
        </a>
    </nav>

    <section class="body">
        <div
            class="tab skills-tab {{tabs.skills.cssClass}}"
            data-group="primary"
            data-tab="skills">
            <div class="career-skills table">
                <div class="career-skills__header table__header">
                    <span class="career-skills__header-field table__header-field">
                        {{localize "WARLOCK.Items.Career.Skill"}}
                    </span>

                    <span class="career-skills__header-field table__header-field">
                        {{localize "WARLOCK.Items.Career.Current"}}
                    </span>

                    <span class="career-skills__header-field table__header-field">
                        {{localize "WARLOCK.Items.Career.Max"}}
                    </span>

                    <!-- The header entries are duplicated since the body is a two-column grid. -->
                    <span class="career-skills__header-field table__header-field">
                        {{localize "WARLOCK.Items.Career.Skill"}}
                    </span>

                    <span class="career-skills__header-field table__header-field">
                        {{localize "WARLOCK.Items.Career.Current"}}
                    </span>

                    <span class="career-skills__header-field table__header-field">
                        {{localize "WARLOCK.Items.Career.Max"}}
                    </span>
                </div>

                <div class="career-skills__body table__body" style="--skill-rows: {{skillRows}}">
                    {{#each data.system.adventuringSkills}}
                    <div
                        class="career-skills__entry table__entry {{#if (eq @index ../skillRows)}}table__entry--column-start{{/if}}"
                        data-skill="{{@key}}">
                        <span class="career-skills__entry-field table__entry-field">
                            {{localizeSkill @key}}
                        </span>

                        <span class="career-skills__entry-field table__entry-field">
                            <a class="toggle-career-skill" data-action="toggleCareerSkill">
                                {{#if isCareerSkill}}
                                <i class="fas fa-check-square"></i>
                                {{else}}
                                <i class="far fa-square"></i>
                                {{/if}}
                            </a>
                        </span>

                        <input
                            class="edit-career-skill-level career-skills__entry-field table__entry-field field field--no-decoration"
                            type="number"
                            value="{{maximumLevel}}"
                            data-dtype="Number"
                            data-career-skill="{{@key}}"
                            {{#unless isCareerSkill}}disabled{{/unless}}>
                    </div>
                    {{/each}}
                </div>
            </div>
        </div>

        <div
            class="tab notes-tab {{tabs.description.cssClass}}"
            data-group="primary"
            data-tab="description">
            <div class="flex flex--column flex--no-gap">
                <prose-mirror
                    name="system.description"
                    value="{{data.system.description}}"
                    data-document-uuid="{{document.uuid}}"
                    toggled
                    {{#unless editable}}disabled{{/unless}}>
                    {{{enriched.description}}}
                </prose-mirror>
            </div>
        </div>
    </section>
</div>
