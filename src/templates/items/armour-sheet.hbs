<div
    class="{{cssClass}} document"
    autocomplete="off">
    <header class="header">
        <img
            class="header__image header__image--small"
            src="{{item.img}}"
            data-action="editImage"
            data-edit="img">

        <div class="header__body">
            <div class="header__row">
                <input
                    class="header__name header__name--small field field--no-decoration field--center"
                    type="text"
                    name="name"
                    value="{{item.name}}"
                    data-dtype="String">
            </div>

            <div class="header__row">
                <div class="resource">
                    <label class="resource__name">
                        {{localize "WARLOCK.Items.Armour.Type"}}
                    </label>

                    <div class="resource__body">
                        <select
                            class="field field--no-decoration"
                            name="system.type.value">
                            {{selectOptions
                                data.system.type.choices
                                selected=data.system.type.value}}
                        </select>
                    </div>
                </div>

                <div class="resource">
                    <label class="resource__name">
                        {{localize "WARLOCK.Items.Armour.ReductionRoll"}}
                    </label>

                    <div class="resource__body">
                        <input
                            class="field field--center field--no-decoration"
                            type="text"
                            name="system.reductionRoll"
                            value="{{data.system.reductionRoll}}"
                            data-dtype="String">
                    </div>
                </div>
            </div>
            {{#if gameConfig.features.firearms}}
            <div class="header__row">
                <div class="resource">
                    <label class="resource__name">
                        {{localize "WARLOCK.Items.Armour.Layers"}}
                    </label>

                    <div class="resource__body">
                        <input
                            class="field field--center field--no-decoration"
                            type="text"
                            name="system.layers"
                            value="{{data.system.layers}}"
                            data-dtype="String">
                    </div>
                </div>
                <div class="resource">
                    <label class="resource__name">
                        {{localize "WARLOCK.Items.Armour.Penalty"}}
                    </label>

                    <div class="resource__body">
                        <input
                            class="field field--center field--no-decoration"
                            type="number"
                            name="system.penalty"
                            value="{{data.system.penalty}}"
                            data-dtype="Number">
                    </div>
                </div>
                <div class="resource">
                    <label class="resource__name">
                        {{localize "WARLOCK.Items.Armour.Conceal"}}
                    </label>

                    <div class="resource__body">
                        <input
                            class="field field--center field--no-decoration"
                            type="text"
                            name="system.conceal"
                            value="{{data.system.conceal}}"
                            data-dtype="String">
                    </div>
                </div>
                <div class="resource">
                    <label class="resource__name">
                        {{localize "WARLOCK.Items.Armour.StopsConcussive"}}
                    </label>

                    <div class="resource__body">
                        <input
                            type="checkbox"
                            name="system.stopsConcussive"
                            {{checked data.system.stopsConcussive}}>
                    </div>
                </div>
                <div class="resource">
                    <label class="resource__name">
                        {{localize "WARLOCK.Items.ResourceCost"}}
                    </label>

                    <div class="resource__body">
                        <input
                            class="field field--center field--no-decoration"
                            type="number"
                            name="system.resourceCost"
                            value="{{data.system.resourceCost}}"
                            data-dtype="Number">
                    </div>
                </div>
            </div>
            {{/if}}
        </div>
    </header>

    <section class="body">
        <div class="flex flex--column flex--no-gap">
            <h1>
                {{localize "WARLOCK.Items.Armour.Description"}}
            </h1>

            <prose-mirror
                name="system.description"
                value="{{data.system.description}}"
                data-document-uuid="{{document.uuid}}"
                toggled
                {{#unless editable}}disabled{{/unless}}>
                {{{enriched.description}}}
            </prose-mirror>
        </div>
    </section>
</div>
