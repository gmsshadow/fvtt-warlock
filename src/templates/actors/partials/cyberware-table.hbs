<div class="cyberware table">
    <div class="cyberware__header table__header">
        <span class="cyberware__header-field table__header-field">
            {{localize "WARLOCK.Items.Cyberware.Name"}}
        </span>

        <span class="cyberware__header-field table__header-field">
            {{localize "WARLOCK.Tables.Category"}}
        </span>

        <span class="cyberware__header-field table__header-field">
            {{localize "WARLOCK.Tables.Points"}}
        </span>

        <span class="cyberware__header-field table__header-field">
            <a
                class="create-item"
                data-action="createItem"
                data-item-type="Cyberware">
                <i class="fas fa-plus"></i> {{localize "WARLOCK.Items.AddItem"}}
            </a>
        </span>
    </div>

    <p class="cyberware__budget">
        {{#each cyberwareBudget}}
        <span class="cyberware__budget-entry {{#if over}}cyberware__budget-entry--over{{/if}}">
            {{localize "WARLOCK.Items.Cyberware.Budget" category=label used=used available=available}}
        </span>
        {{/each}}
        {{#if cyberwarePenalty}}
        <span class="cyberware__budget-entry">
            {{localize "WARLOCK.Chat.Spell.CyberwarePenalty" penalty=cyberwarePenalty}}
        </span>
        {{/if}}
    </p>

    <div class="cyberware__body table__body">
        {{#each data.system.gear.cyberware}}
        <div
            class="cyberware__entry table__entry table__entry--tall draggable"
            data-item-id="{{id}}">
            <span class="cyberware__entry-field table__entry-field">
                <img
                    class="table__entry-image"
                    src="{{img}}">

                <a class="toggle-description" data-action="toggleDescription">
                    {{name}}
                </a>
            </span>

            <span class="cyberware__entry-field table__entry-field">
                {{system.category.value}}
            </span>

            <span class="cyberware__entry-field table__entry-field">
                {{system.points}}{{#unless system.isInstalled}}*{{/unless}}
            </span>

            <span class="cyberware__entry-field table__entry-field">
                <a
                    class="chat-item"
                    data-action="chatItem"
                    title="{{localize "WARLOCK.Items.ChatItem"}}">
                    <i class="fas fa-comment"></i>
                </a>

                <a
                    class="edit-item"
                    data-action="editItem"
                    title="{{localize "WARLOCK.Items.EditItem"}}">
                    <i class="fas fa-edit"></i>
                </a>

                <a
                    class="delete-item"
                    data-action="deleteItem"
                    title="{{localize "WARLOCK.Items.DeleteItem"}}">
                    <i class="fas fa-trash"></i>
                </a>
            </span>
        </div>

        <div class="table__entry-field--collapsible">
            {{{system.description}}}
        </div>
        {{/each}}
    </div>
</div>
