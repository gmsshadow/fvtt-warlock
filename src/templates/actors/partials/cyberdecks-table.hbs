<div class="cyberdecks table">
    <div class="cyberdecks__header table__header">
        <span class="cyberdecks__header-field table__header-field">
            {{localize "WARLOCK.Items.Cyberdeck.Name"}}
        </span>

        <span class="cyberdecks__header-field table__header-field">
            {{localize "WARLOCK.Tables.Quality"}}
        </span>

        <span class="cyberdecks__header-field table__header-field">
            <a
                class="create-item"
                data-action="createItem"
                data-item-type="Cyberdeck">
                <i class="fas fa-plus"></i> {{localize "WARLOCK.Items.AddItem"}}
            </a>
        </span>
    </div>

    <div class="cyberdecks__body table__body">
        {{#each data.system.gear.cyberdecks}}
        <div
            class="cyberdecks__entry table__entry table__entry--tall draggable"
            data-item-id="{{id}}">
            <span class="cyberdecks__entry-field table__entry-field">
                <img
                    class="table__entry-image"
                    src="{{img}}">

                <a class="toggle-description" data-action="toggleDescription">
                    {{name}}
                </a>
            </span>

            <span class="cyberdecks__entry-field table__entry-field">
                {{system.quality}}
            </span>

            <span class="cyberdecks__entry-field table__entry-field">
                <a
                    class="chat-item"
                    data-action="chatItem"
                    title="{{localize "WARLOCK.Items.ChatItem"}}">
                    <i class="fas fa-comment"></i>
                </a>

                <a
                    class="edit-item"
                    data-action="editItem"
                    title="{{localize "WARLOCK.Items.EditItem"}}">
                    <i class="fas fa-edit"></i>
                </a>

                <a
                    class="delete-item"
                    data-action="deleteItem"
                    title="{{localize "WARLOCK.Items.DeleteItem"}}">
                    <i class="fas fa-trash"></i>
                </a>
            </span>
        </div>

        <div class="table__entry-field--collapsible">
            {{{system.description}}}
        </div>
        {{/each}}
    </div>
</div>
